{
  "name": "zarya-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @zarya/web",
    "dev:cms": "npm run dev --workspace @zarya/cms",
    "dev:moderation": "npm run dev --workspace @zarya/moderation",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck --workspace apps",
    "test:unit": "npm run test:unit --workspace apps",
    "build": "npm run build --workspace apps",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:e2e": "playwright test",
    "dev:web:mock": "npm run dev:mock --workspace @zarya/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
